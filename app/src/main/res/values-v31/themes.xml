<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ : sistem splash ekranı USTlabs amblemiyle açılır, ardından
         Compose açılış sekansı (LaunchSequenceOverlay) devralır. -->
    <style name="Theme.MotoCross" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@drawable/splash_window_background</item>
        <item name="android:statusBarColor">@color/motocross_black</item>
        <item name="android:navigationBarColor">@color/motocross_black</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>

        <item name="android:windowSplashScreenBackground">@color/motocross_black</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_splash_ustlabs</item>
        <item name="android:windowSplashScreenAnimationDuration">450</item>
    </style>
</resources>
